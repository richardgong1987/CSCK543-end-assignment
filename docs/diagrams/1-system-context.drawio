<mxfile host="Recipe Box" agent="docs/diagrams"><diagram id="1-system-context" name="System context"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="system" value="Recipe Box" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="620" height="440" as="geometry"/></mxCell><mxCell id="visitor" value='&lt;b&gt;Visitor&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;searches and reads recipes,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;no account needed&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="113" width="240" height="84" as="geometry"/></mxCell><mxCell id="member" value='&lt;b&gt;Registered user&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;also saves and rates recipes&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;and manages the account&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="84" as="geometry"/></mxCell><mxCell id="client" value='&lt;b&gt;API client&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;any program, such as&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;the k6 load test&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="240" height="84" as="geometry"/></mxCell><mxCell id="web" value='&lt;b&gt;Web application&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;Laravel 13 on PHP 8.5&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;HTML pages built on the server&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="260" height="100" as="geometry"/></mxCell><mxCell id="api" value='&lt;b&gt;JSON search API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;GET /api/recipes&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;public, read-only, rate limited&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="362" width="260" height="100" as="geometry"/></mxCell><mxCell id="db" value='&lt;b&gt;MySQL / MariaDB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;recipes, users, favourites,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;ratings, sessions&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="220" width="200" height="140" as="geometry"/></mxCell><mxCell id="mail" value='&lt;b&gt;Mail&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;password reset links; written to&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;the log file in development&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="260" height="100" as="geo