<mxfile host="Recipe Box" agent="docs/diagrams"><diagram id="2-xampp-runtime" name="Running on XAMPP"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="machine" value="One computer running XAMPP — the tested macOS set-up (Linux is the same)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="1190" height="580" as="geometry"/></mxCell><mxCell id="apache" value="XAMPP Apache 2.4 — recipebox.localhost, port 80" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="400" height="480" as="geometry"/></mxCell><mxCell id="chrome" value='&lt;b&gt;Google Chrome&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;HTML · Tailwind CSS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;vanilla JavaScript&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="240" height="100" as="geometry"/></mxCell><mxCell id="htaccess" value='&lt;b&gt;public/.htaccess&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;send unknown paths to index.php&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;gzip text · cache lifetimes&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="300" height="100" as="geometry"/></mxCell><mxCell id="static" value='&lt;b&gt;Static files in public/&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;build/ — CSS, JS, fonts (hashed names)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;images/ — recipe photos, WebP and JPEG&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="440" width="300" height="100" as="geometry"/></mxCell><mxCell id="fpm" value='&lt;b&gt;PHP-FPM 8.5 · pool &amp;quot;recipebox&amp;quot;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;runs Laravel 13 through public/index.php&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;reads .env.xampp&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="930" y="180" width="300" height="100" as="geometry"/></mxCell><mxCell id="db" value='&lt;b&gt;XAMPP MariaDB 10.4&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;port 3307 · database csck543&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;tables, sessions, cache,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;rate-limit counters&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="220" height="160" as="geometry"/></mxCell><mxCell id="log" value='&lt;b&gt;storage/logs/laravel.log&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;errors, and password reset emails&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;while MAIL_MAILER=log&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=