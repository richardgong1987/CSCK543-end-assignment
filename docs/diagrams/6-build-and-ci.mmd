---
title: Building the front end, and the checks on every push
---
flowchart LR
    subgraph source["Source in git"]
        direction TB
        css["resources/css/app.css<br/>Tailwind CSS 4"]
        js["resources/js/*.js<br/>vanilla JavaScript"]
        views["resources/views/**/*.blade.php"]
        fonts["@fontsource/instrument-sans<br/>three WOFF2 files"]
    end

    vite["<b>pnpm run build</b><br/>Vite 8 + laravel-vite-plugin<br/>minifies, adds content hashes"]
    build["<b>public/build/</b><br/>app-[hash].css · app-[hash].js<br/>fonts · manifest.json"]
    blade["<b>@vite and @fonts</b> in the layout<br/>print the hashed file names,<br/>each with the page's CSP nonce"]

    css --> vite
    js --> vite
    fonts --> vite
    views -. "Tailwind keeps only the<br/>classes the views use" .-> vite
    vite --> build --> blade

    subgraph ci["GitHub Actions — every push and pull request"]
        direction TB
        unit["<b>Unit and feature tests</b><br/>Pest · composer test"]
        e2e["<b>End-to-end tests</b><br/>Playwright in Chrome"]
        audit["<b>Dependency audit</b><br/>composer audit · pnpm audit"]
    end

    source -- "git push" --> ci

    classDef src fill:#f5f3ff,stroke:#6d28d9,color:#1f2937
    classDef app fill:#e8f1fb,stroke:#1d4ed8,color:#1f2937
    classDef check fill:#ecfdf3,stroke:#15803d,color:#1f2937
    class css,js,views,fonts src
    class vite,build,blade app
    class unit,e2e,audit check
