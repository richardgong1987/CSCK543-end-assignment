<mxfile host="Recipe Box" agent="docs/diagrams"><diagram id="7-production-deployment" name="Proposed production deployment"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="status" value="Proposed design from the proposal (§10). Nothing here has been deployed." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="420" height="56" as="geometry"/></mxCell><mxCell id="public" value="Public zone" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="250" width="420" height="170" as="geometry"/></mxCell><mxCell id="private" value="Private network — the firewall allows only the arrows shown" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;spacingLeft=300;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1200" height="480" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Visitors and API clients&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="260" height="60" as="geometry"/></mxCell><mxCell id="cdn" value='&lt;b&gt;CDN — optional&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;copies of build/ and images/&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;close to visitors&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="260" height="90" as="geometry"/></mxCell><mxCell id="proxy" value='&lt;b&gt;Reverse proxy&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;the only machine with a public address&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;HTTPS · HTTP/2 · Brotli · 80 redirects to 443&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="340" height="100" as="geometry"/></mxCell><mxCell id="operators" value="&lt;b&gt;Operators&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="260" height="60" as="geometry"/></mxCell><mxCell id="bastion" value="&lt;b&gt;VPN or bastion host&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="540" width="260" height="70" as="geometry"/></mxCell><mxCell id="app" value='&lt;b&gt;Application server&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;Apache or nginx + PHP-FPM 8.5 · Laravel 13&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;APP_ENV=production · APP_DEBUG=false&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;config, routes and views cached&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="530" width="340" height="130" as="geometry"/></mxCell><mxCell id="db" value='&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;no public a