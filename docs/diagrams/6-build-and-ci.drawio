<mxfile host="Recipe Box" agent="docs/diagrams"><diagram id="6-build-and-ci" name="Build and continuous integration"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="source" value="Source in git" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="320" height="500" as="geometry"/></mxCell><mxCell id="ci" value="GitHub Actions — every push and pull request" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=15;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="540" width="1000" height="160" as="geometry"/></mxCell><mxCell id="css" value='&lt;b&gt;resources/css/app.css&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;Tailwind CSS 4&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="js" value='&lt;b&gt;resources/js/*.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;vanilla JavaScript&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="260" height="70" as="geometry"/></mxCell><mxCell id="fonts" value='&lt;b&gt;@fontsource/instrument-sans&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#333333"&gt;three WOFF2 files&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;fontFamily=Helvetica;